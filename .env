# Host and Port where the host operates
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000

FRONTEND_HOST=127.0.0.1
FRONTEND_ORIGIN=https://127.0.0.1:5173


# The back-end host to connect for data comms
# BACKEND_HOST_URL=https://www.example.com:5000

# Certificate paths to communicate with the browser
TLS_KEY=../../websites/server.key
TLS_CERT=../../websites/server.crt

# NODE_TLS_REJECT_UNAUTHORIZED=0

# path to an authority trust certificate if you have one - in which case remove the NODE_TLS_REJECT_UNAUTHROIZED line
# for example C:\\Server\\ca.pem
# NODE_EXTRA_CA_CERTS=C:\\Server\\ca.pem

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
