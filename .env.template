# ==============================
# Server
# ==============================
# Host and Port where the host operates
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000

# ==============================
# Frontend
# ==============================
# Front end host/origin where the request is expected to come from
FRONTEND_HOST=127.0.0.1
FRONTEND_ORIGIN=https://127.0.0.1:5173

# Reflect the incoming Origin header in Access-Control-Allow-Origin.
# 1 = reflect request origin
# 0 = use FRONTEND_ORIGIN
REFLECT_ORIGIN=1

# ==============================
# HTTPS / TLS
# ==============================
# TLS certificate files used when SSL is enabled.
# Examples:
# TLS_KEY=/websites/server.key
# TLS_CERT=/websites/server.crt
# TLS_PASSPHRASE=Password/passphrase used to decrypt an encrypted private key.
# Leave empty if the private key is not encrypted.
TLS_KEY=/path/to/server.key
TLS_CERT=/path/to/server.crt
TLS_PASSPHRASE=

# Enable HTTPS mode.
# 1 = enabled
# 0 = disabled
SSL_ENABLED=1

# ==============================
# Cookies
# ==============================
# Include the Domain attribute in Set-Cookie headers.
# 1 = include Domain
# 0 = omit Domain (host-only cookie)
COOKIE_USE_DOMAIN=0

# Preferences Directory
PREFERENCES_DIR=prefs

# key to encode the preference filenames with for example 123ABC-456DEF if required
ENCODING_KEY=

# ==============================
# MySQL Connections
# ==============================
# MySQL2 Protocol connection
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=

# MySQL X Protocol connection
DB_XHOST=127.0.0.1
DB_XPORT=33060
DB_XUSER=root
DB_XPASSWORD=

# ==============================
# Application Database User
# ==============================
DB_APP_HOST=127.0.0.2
DB_APP_PORT=3306
DB_APP_USER=appUser
DB_APP_PASSWORD=

DB_APP_XHOST=127.0.0.2
DB_APP_XPORT=33061
DB_APP_XUSER=appUser
DB_APP_XPASSWORD=

# ==============================
# Store Responses
# ==============================
MOCK_OUTPUT_DIR=

# ==============================
# AI Connect
# ==============================
# Set AI_MODEL to provider:model and provide the corresponding API key.
# openai:gpt-5.4
# anthropic:claude-sonnet-4-6
# google_genai:gemini-3.5-flash
AI_MODEL=
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=